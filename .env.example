# Server-only ElevenLabs TTS. Never expose these as VITE_* variables.
ELEVENLABS_API_KEY=

# Use an original/premade synthetic voice, not a cloned real person's voice.
ELEVENLABS_GUEST_VOICE_ID=

# Optional. MOM falls back to GUEST; MOM_IMPOSTOR falls back to MOM.
ELEVENLABS_MOM_VOICE_ID=
ELEVENLABS_MOM_IMPOSTOR_VOICE_ID=
